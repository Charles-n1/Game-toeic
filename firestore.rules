rules_version = '2';

// 🔒 Who can read / write what in the database (paste this in Firebase > Firestore > Rules).
// Each account has ONE document, users/{its id}: only this account can read it and write it.
// Everything else is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['save', 'savedAt'])
        && request.resource.data.save is string
        && request.resource.data.savedAt is int;
    }
  }
}
